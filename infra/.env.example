# Variables requises pour infra/docker-compose.v1.yml
# Copier vers infra/.env (ou exporter dans l'environnement) et remplacer les valeurs avant démarrage.
# Ne jamais committer de fichier .env contenant de vrais secrets.

PLATFORM_SHARED_SECRET=replace-with-random-secret-at-least-32-chars

IAM_DB_USER=iam
IAM_DB_PASSWORD=replace-with-iam-db-password
IAM_DB_NAME=iam

NOCODE_DB_USER=nocode
NOCODE_DB_PASSWORD=replace-with-nocode-db-password
NOCODE_DB_NAME=nocode_builder_v2

# IA (optionnel : laisser AI_API_KEY vide desactive les routes IA avec 503 AI_NOT_CONFIGURED)
AI_PROVIDER=mistral
AI_MODEL=mistral-small-latest
AI_BASE_URL=https://api.mistral.ai/v1
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
