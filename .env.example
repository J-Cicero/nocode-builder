# .env.example — NoCode Builder
# Copiez ce fichier en .env et renseignez vos valeurs locales.
# Ne commitez JAMAIS le fichier .env réel.

# ─── Environnement ───────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="NoCode Builder"

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nocode
POSTGRES_PASSWORD=nocode
POSTGRES_DB=nocode_builder_v2

# ─── Sécurité (Sprint 2) ─────────────────────────────────────────────────────
SECRET_KEY=changeme-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Intelligence Artificielle (Sprint 3) ────────────────────────────────────
AI_PROVIDER=mistral
AI_API_KEY=your_mistral_api_key_here
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-latest

# ─── Déploiement (Sprint 4+) ─────────────────────────────────────────────────
# VERCEL_TOKEN=your_token_here
# VERCEL_TEAM_SLUG=your_team_slug
# RAILWAY_API_TOKEN=your_token_here
